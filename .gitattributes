# Автоматически определять текстовые файлы и выполнять нормализацию конца строк (LF)
* text=auto

# Определение текстовых файлов
*.php text
*.js text
*.html text
*.css text
*.json text
*.md text
*.xml text
*.yml text
*.yaml text
*.sql text
*.txt text
*.ini text
*.sh text eol=lf
*.bat text eol=crlf

# Бинарные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.rar binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary

# Исключить из статистики языков некоторые директории
/vendor/* linguist-vendored
/node_modules/* linguist-vendored
/frontend/web/assets/* linguist-vendored
/backend/web/assets/* linguist-vendored

# Игнорировать в экспорте архива проекта
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
phpunit.xml.dist export-ignore
*.md export-ignore
/tests export-ignore 